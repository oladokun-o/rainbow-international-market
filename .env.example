# Rainbow International Market — environment variables
# Copy to `.env` (at the repo root) and fill with real values. Never commit `.env`.

# ── Sanity ──────────────────────────────────────────────────────────
PUBLIC_SANITY_PROJECT_ID="your-project-id"
# `development` locally (private dataset) / `production` in Vercel prod (public read)
PUBLIC_SANITY_DATASET="development"
PUBLIC_SANITY_API_VERSION="2026-05-15"
# No PUBLIC_ prefix — server only. Needed even for READ queries against the
# private `development` dataset; prod reads the public `production` dataset CDN-only.
SANITY_API_READ_TOKEN="your-read-token"
# Editor-role token — ONLY used by scripts/seed.mjs, never by the app.
SANITY_WRITE_TOKEN=""

# ── MongoDB (orders datastore) ──────────────────────────────────────
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="rainbow"

# ── Resend (transactional email) ────────────────────────────────────
# Optional — the email channel skips gracefully when unset. Custom sending
# domain is not connected yet; until then use the Resend sandbox sender.
RESEND_API_KEY=""
EMAIL_FROM="Rainbow International Market <onboarding@resend.dev>"
# Where "new order" notifications go. Leave blank to skip the admin copy.
ADMIN_EMAIL=""

# ── App ─────────────────────────────────────────────────────────────
# Secret for HMAC-signed session cookies (admin). Generate a long random string.
SESSION_SECRET="change-me-to-a-long-random-string"
PUBLIC_BASE_URL="http://localhost:5173"

# ── Admin seed (scripts/seed-admin.mjs) ─────────────────────────────
# The first owner account. Run `npm run seed:admin` once after setting these.
ADMIN_SEED_NAME="Store Owner"
ADMIN_SEED_EMAIL="owner@rainbowinternationalmarket.com"
ADMIN_SEED_PASSWORD="change-me-min-10-chars"
